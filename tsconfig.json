{
	"compilerOptions": {
		"lib": ["ES2022", "DOM"],
		"resolveJsonModule": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"sourceMap": false,
		"target": "ES2022",
		"esModuleInterop": true,
		"outDir": "lib",
		"rootDir": "./src",
		"types": ["node"]
	},
	"exclude": ["node_modules", "doc", "tests"]
}
