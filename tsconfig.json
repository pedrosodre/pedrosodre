{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": false,
    "target": "ES2022",
    "esModuleInterop": true,
    "outDir": "lib",
    "rootDir": "./src",
    "types": ["node"]
  },
  "exclude": ["bin", "node_modules", "doc", "tests"]
}
